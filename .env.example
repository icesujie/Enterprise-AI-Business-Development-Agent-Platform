# Local development values only. Never use these credentials in production.
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://sariarta:sariarta_dev@localhost:5432/sariarta
REDIS_URL=redis://localhost:6379/0
AUTH_ISSUER=https://local.supabase.example/auth/v1
AUTH_AUDIENCE=authenticated
AUTH_JWKS_URL=https://local.supabase.example/auth/v1/.well-known/jwks.json
AUTH_JWKS_CACHE_SECONDS=600
DEVELOPMENT_AUTH_SUBJECT=30000000-0000-4000-8000-000000000001
# Local frontend demo login only; ignored outside APP_ENVIRONMENT=development.
DEMO_AUTH_EMAIL=admin@sariarta.local
DEMO_AUTH_PASSWORD=SariArtaDemo2026!
DEMO_AUTH_SECRET=local-demo-session-secret-change-before-shared-use
PUBLIC_SITE_TOKEN=local-public-site-token
PUBLIC_TENANT_ID=10000000-0000-4000-8000-000000000001
PUBLIC_RATE_LIMIT=10
PUBLIC_CONSULTATION_RATE_LIMIT=30
PUBLIC_CONSULTATION_AI_ENABLED=false
PUBLIC_RATE_WINDOW_SECONDS=60
# false = deterministic local/demo qualification; true = OpenAI Agents SDK
AI_ENABLED=false
# Required only when AI_ENABLED=true. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AGENT_QUEUE_NAME=sari-arta:agent-runs
AGENT_TIMEOUT_SECONDS=45
AGENT_MAX_TURNS=3
AGENT_MAX_OUTPUT_TOKENS=1200
AGENT_MAX_ATTEMPTS=3
AGENT_RETRY_BASE_SECONDS=2
AGENT_STALE_AFTER_SECONDS=120
AGENT_RECOVERY_INTERVAL_SECONDS=30
# Phase 2.5 knowledge ingestion. "mock" is deterministic and API-key free.
KNOWLEDGE_STORAGE_PATH=.local/knowledge
KNOWLEDGE_MAX_UPLOAD_BYTES=10485760
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=200
KNOWLEDGE_EMBEDDING_PROVIDER=mock
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_QUEUE_NAME=sari-arta:knowledge-ingestion
KNOWLEDGE_PROCESSING_QUEUE_NAME=sari-arta:knowledge-processing
KNOWLEDGE_RETRIEVAL_MIN_SIMILARITY=0.15
KNOWLEDGE_RETRIEVAL_MIN_EVIDENCE_COUNT=1
KNOWLEDGE_RETRIEVAL_DIAGNOSTIC_CANDIDATES=5
KNOWLEDGE_ASSISTANT_TOP_K=5
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
